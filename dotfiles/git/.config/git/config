[user]
	name = Vick Kumar
	# email lives in ~/.config/git/local (untracked), written by install/30-dev.sh
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rebase]
	autoStash = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictstyle = zdiff3
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
[include]
	path = ~/.config/git/local
