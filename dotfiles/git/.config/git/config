[user]
	name = Vick Kumar
	# email is set by bootstrap.sh (git config --global user.email ...)
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rebase]
	autoStash = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictstyle = zdiff3
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
